[{"cut":"Brisket (packer)","note":"Plan 1–1.25 hrs per lb, plus a 1–2 hr rest.","pit":"250°F","rate":75,"unit":"min/lb"},{"cut":"Pork butt / shoulder","note":"About 1.5 hrs per lb. Bone wiggle tells the truth.","pit":"250°F","rate":90,"unit":"min/lb"},{"cut":"Chuck roast","note":"Cooks like a small brisket.","pit":"250°F","rate":90,"unit":"min/lb"},{"cut":"Beef short ribs","fixed":"8–10 hrs","note":"By feel, not weight — probe-tender wins.","pit":"250°F","rate":null,"unit":"fixed"},{"cut":"St. Louis ribs","fixed":"5–6 hrs","note":"3-2-1 is a guide, not a law. Bend test.","pit":"250°F","rate":null,"unit":"fixed"},{"cut":"Baby back ribs","fixed":"4–5 hrs","note":"Bend test — they crack, not break.","pit":"250°F","rate":null,"unit":"fixed"},{"cut":"Whole chicken","note":"Spatchcocked cooks faster and more even.","pit":"300°F","rate":20,"unit":"min/lb"},{"cut":"Turkey (whole)","note":"Spatchcock it. Breast 160°F, thigh 175°F.","pit":"300°F","rate":15,"unit":"min/lb"},{"cut":"Pork loin","note":"Pull at 145°F — don't treat it like a butt.","pit":"250°F","rate":25,"unit":"min/lb"},{"cut":"Leg of lamb","note":"130–135°F for med-rare.","pit":"275°F","rate":25,"unit":"min/lb"}]